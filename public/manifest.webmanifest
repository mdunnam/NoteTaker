{
  "name": "QNote",
  "short_name": "QNote",
  "description": "Capture thoughts fast, let AI organize, and resurface what matters.",
  "start_url": "/inbox",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick capture",
      "short_name": "Capture",
      "url": "/capture"
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox"
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
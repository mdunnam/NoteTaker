{
  "name": "qnote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "desktop:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config src-tauri/tauri.conf.json",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npx tsc --noEmit && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.31",
    "@aws-sdk/client-bedrock-runtime": "^3.1028.0",
    "@aws-sdk/client-comprehend": "^3.1028.0",
    "@aws-sdk/client-polly": "^3.1028.0",
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/client-transcribe": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
    "@prisma/client": "^5.12.0",
    "ai": "^3.2.2",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.21",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.4.38",
    "prisma": "^5.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^21.0.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1028.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "eslint": "^8.57.0",

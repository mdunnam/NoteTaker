# App
NODE_ENV="development"

# Base URL (local)
NEXTAUTH_URL="http://localhost:3000"

# Auth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Database (Vercel Postgres / Neon / Supabase Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qnote?sslmode=require"

# Optional direct DB URL for Prisma migrations (if your provider gives one)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/qnote?sslmode=require"

# OpenAI
OPENAI_API_KEY="sk-replace-with-your-openai-key"

# Optional: app URL for client-side links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

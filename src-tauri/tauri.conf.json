{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QNote Capture Helper",
  "version": "0.1.0",
  "identifier": "com.qnote.capturehelper",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QNote Capture Helper",
        "url": "index.html",
        "width": 520,
        "height": 460,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "QNote",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Global-hotkey helper that launches QNote capture in your browser",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "QNote"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
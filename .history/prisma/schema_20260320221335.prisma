// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for NextAuth.js
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // hashed
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  notes         Note[]
  collections   Collection[]
  entities      Entity[]
  preferences   UserPreferences?

  @@index([email])
}

model UserPreferences {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  defaultCollection String?
  theme         String    @default("system")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Core Note model
model Note {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawContent        String    @db.Text
  title             String?
  summary           String?   @db.Text
  category          String?
  type              String?   // TASK, IDEA, NOTE, REFERENCE, etc.
  
  tags              String[]  @default([])
  suggestedProject  String?
  extractedTasks    Json?     // Array of { text, dueDate?, completed? }
  extractedDates    Json?     // Array of dates mentioned
  extractedEntities Json?     // Array of { type, name } for people, projects, etc.
  
  status            NoteStatus @default(UNPROCESSED) // UNPROCESSED, PROCESSING, PROCESSED
  confidenceScore   Float?    @default(0.5)
  
  embedding         Unsupported("vector(1536)")?  // OpenAI text-embedding-3-small is 1536 dims
  
  isArchived        Boolean   @default(false)
  isPinned          Boolean   @default(false)
  isSplitFrom       String?   // If this note was split from another
  
  collectionId      String?
  collection        Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  
  relatedNotesFrom  NoteRelation[] @relation("source")
  relatedNotesTo    NoteRelation[] @relation("target")
  
  entities          NoteEntity[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([collectionId])
  @@index([isArchived])
  @@index([createdAt])
}

enum NoteStatus {
  UNPROCESSED
  PROCESSING
  PROCESSED
}

// Related notes (many-to-many with score)
model NoteRelation {
  id            String    @id @default(cuid())
  sourceNoteId  String
  targetNoteId  String
  
  sourceNote    Note      @relation("source", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote    Note      @relation("target", fields: [targetNoteId], references: [id], onDelete: Cascade)
  
  score         Float     @default(0.5) // Similarity score 0-1
  reason        String?   // Why they're related
  
  createdAt     DateTime  @default(now())

  @@unique([sourceNoteId, targetNoteId])
  @@index([sourceNoteId])
  @@index([targetNoteId])
}

// Collections (user-created containers like Work, Personal, etc.)
model Collection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?   @db.Text
  color         String?   @default("gray")
  icon          String?
  
  notes         Note[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// Entities detected by AI (people, projects, topics, etc.)
model Entity {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          EntityType
  name          String
  description   String?   @db.Text
  permalink     String?   // URL-friendly name
  
  notes         NoteEntity[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, type, name])
  @@index([userId])
  @@index([type])
}

enum EntityType {
  PERSON
  PROJECT
  APP
  COMPANY
  PLACE
  TOPIC
}

// Junction table for notes and entities (many-to-many)
model NoteEntity {
  id            String    @id @default(cuid())
  noteId        String
  entityId      String
  
  note          Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  entity        Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  mentionCount  Int       @default(1)
  lastMentioned DateTime  @updatedAt

  @@unique([noteId, entityId])
  @@index([noteId])
  @@index([entityId])
}

// API keys for various services
model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String    // e.g., "OpenAI", "Neon"
  key           String    @db.Text
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
